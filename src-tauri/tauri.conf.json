{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fujicloud",
  "version": "0.1.0",
  "identifier": "app.fujicloud.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fujicloud",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "transparent": true,
        "theme": "Dark",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: fuji: http://fuji.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost fuji: http://fuji.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Photography",
    "shortDescription": "A fast photo library for Fujifilm shooters",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
